# Copy to `.env` in the repo root. Do not commit real secrets.

# PostgreSQL
POSTGRES_USER=wimp
POSTGRES_PASSWORD=wimp
POSTGRES_DB=wimp
DATABASE_URL=postgresql://wimp:wimp@localhost:5432/wimp

# API
API_PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-local-secret
COOKIE_SECURE=false
STATUS_DEFAULT_TTL_MINUTES=240

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1
